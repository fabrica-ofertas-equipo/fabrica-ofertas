{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jurado.schema.json",
  "title": "jurado_creativos (PROPUESTA 0.1.0 de S-C; no es todavía un contrato de contratos/)",
  "description": "ofertas/<id>/06-creativos/jurado.json: la salida de UNA tanda del Jurado de creativos. Compatible con lo que lee dashboard/web/lib/jurado.js (votos[], orden[], precision, ideas[], modo, sello, generado_en, locale). Reglas de honestidad que el esquema hace cumplir: en modo «sombra» o «apagado» aplica_orden es false; un voto es un booleano; ninguna cifra del jurado sin la advertencia de uso interno. Pedido a S-A para convertirlo en contrato: PEDIDOS.md #1.",
  "type": "object",
  "required": ["schema_version", "tipo", "demostracion", "oferta_id", "locale", "generado_en", "sellado_en", "modo", "aplica_orden", "semilla", "semilla_origen",
               "hash_orden", "consigna_sha256", "avatares", "n_jueces", "completitud", "votos", "piezas", "orden", "acuerdo", "anclas", "ideas", "advertencias",
               "aviso_uso", "precision", "sello"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "tipo": {"const": "jurado_creativos"},
    "demostracion": {"type": "boolean", "description": "true = votos sintéticos sin LLM; jamás entra a una calibración real"},
    "oferta_id": {"type": ["string", "null"]},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "mercado": {"type": "string"},
    "tanda_id": {"type": ["string", "null"]},
    "generado_en": {"type": "string"},
    "sellado_en": {"type": "string", "description": "la predicción se sella ANTES de ver ningún resultado; la calibración descarta las posteriores a la lectura de métricas"},
    "modo": {"enum": ["sombra", "asesor", "apagado"]},
    "aplica_orden": {"type": "boolean"},
    "modo_motivo": {"type": "string"},
    "semilla": {"type": ["string", "integer"]},
    "semilla_origen": {"enum": ["explicita", "derivada"]},
    "hash_orden": {"$ref": "#/$defs/sha256"},
    "consigna_version": {"type": "string"},
    "consigna_sha256": {"$ref": "#/$defs/sha256"},
    "entradas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "avatares": {"type": "array", "items": {"type": "object", "required": ["avatar_id", "estilo_decision", "estado"],
                 "properties": {"avatar_id": {"type": "string"}, "estilo_decision": {"type": "string"}, "estado": {"enum": ["activo", "retirado"]},
                                "preocupacion": {"type": ["string", "null"]}, "nivel_evidencia": {"type": ["string", "null"]}}}},
    "n_jueces": {"type": "integer", "minimum": 1},
    "completitud": {"type": "object", "required": ["llamadas_esperadas", "votos_aceptados", "rechazados", "cuarentena", "faltantes", "proporcion"],
                    "properties": {"llamadas_esperadas": {"type": "integer"}, "votos_aceptados": {"type": "integer"}, "rechazados": {"type": "integer"},
                                   "cuarentena": {"type": "integer"}, "faltantes": {"type": "integer"}, "proporcion": {"type": "number", "minimum": 0, "maximum": 1}}},
    "votos": {"type": "array", "items": {"$ref": "#/$defs/voto"}},
    "piezas": {"type": "array", "items": {"$ref": "#/$defs/pieza"}},
    "orden": {"type": "array", "items": {"type": "object", "required": ["ad_name", "posicion", "puntaje"],
              "properties": {"ad_name": {"type": "string"}, "posicion": {"type": "integer", "minimum": 1}, "puntaje": {"type": "number", "minimum": 0, "maximum": 10},
                             "score": {"type": "number"}, "share_si": {"type": "number", "minimum": 0, "maximum": 1}, "empate": {"type": "boolean"},
                             "separable_del_siguiente": {"type": ["boolean", "null"]}, "confianza": {"enum": ["alta", "media", "baja"]}}}},
    "sin_orden": {"type": "array", "items": {"type": "object", "required": ["ad_name", "motivo"], "properties": {"ad_name": {"type": "string"},
                  "n_votos": {"type": "integer"}, "motivo": {"type": "string"}}}},
    "acuerdo": {"type": "object", "properties": {"kappa_fleiss": {"type": ["number", "null"]}, "jueces_por_pieza": {"type": "integer"},
                "piezas_en_kappa": {"type": "integer"}, "acuerdo_medio_por_pieza": {"type": ["number", "null"]}, "tasa_aprobacion_global": {"type": ["number", "null"]},
                "dispersion_de_si_entre_piezas": {"type": ["number", "null"]}, "lectura": {"type": "string"}}},
    "anclas": {"type": "object", "required": ["detalle", "medidas", "control_sintetico", "discrimina", "sesgo_de_aprobacion"],
               "properties": {"detalle": {"type": "array", "items": {"type": "object", "required": ["ancla_id", "veredicto_conocido", "origen_resultado"],
                              "properties": {"ancla_id": {"type": "string"}, "veredicto_conocido": {"enum": ["ganadora", "perdedora"]},
                                             "origen_resultado": {"enum": ["medida", "control_sintetico"]}, "n_votos": {"type": "integer"},
                                             "share_si": {"type": ["number", "null"]}, "puntaje_medio": {"type": ["number", "null"]}}}},
                              "medidas": {"type": "integer"}, "control_sintetico": {"type": "integer"}, "share_si_ganadoras": {"type": ["number", "null"]},
                              "share_si_perdedoras": {"type": ["number", "null"]}, "discrimina": {"type": "boolean"}, "margen_minimo": {"type": "number"},
                              "sesgo_de_aprobacion": {"type": "boolean"}, "nota": {"type": "string"}}},
    "baseline_rubrica": {"type": "array", "items": {"type": "object", "required": ["ad_name", "score"], "properties": {"ad_name": {"type": "string"},
                         "score": {"type": "number", "minimum": 0, "maximum": 10}, "n_items": {"type": "integer"}}}},
    "ideas": {"type": "array", "maxItems": 12, "items": {"type": "object", "required": ["idea", "origen"], "properties": {"idea": {"type": "string"},
              "origen": {"const": "jurado"}, "avatar_id": {"type": "string"}}}},
    "ideas_nota": {"type": "string"},
    "rechazados": {"type": "array", "items": {"type": "object", "required": ["archivo", "motivos"], "properties": {"archivo": {"type": "string"},
                   "paquete_id": {"type": ["string", "null"]}, "motivos": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
    "cuarentena": {"type": "array", "items": {"type": "object", "required": ["paquete_id", "alerta"], "properties": {"archivo": {"type": "string"},
                   "paquete_id": {"type": "string"}, "alerta": {"type": "string"}}}},
    "faltantes": {"type": "array", "items": {"type": "string"}},
    "advertencias": {"type": "array", "items": {"type": "string"}},
    "aviso_uso": {"type": "string", "pattern": "nunca se citan"},
    "sello_alcance": {"type": "string"},
    "precision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/precision"}], "description": "null hasta que calibrar.py la fusione; queda FUERA del alcance del sello"},
    "calibracion_ref": {"type": "object", "properties": {"archivo": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "calculado_en": {"type": "string"},
                        "estado_global": {"enum": ["acumulando", "sombra", "apagar", "elegible_asesor"]}}},
    "sello": {"$ref": "#/$defs/sha256"}
  },
  "patternProperties": {"^_": {}},
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"modo": {"enum": ["sombra", "apagado"]}}}, "then": {"properties": {"aplica_orden": {"const": false}}}},
    {"if": {"properties": {"demostracion": {"const": true}}}, "then": {"properties": {"advertencias": {"contains": {"pattern": "DEMOSTRACIÓN"}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "voto": {"type": "object", "required": ["ad_name", "avatar_id", "voto", "motivo", "puntaje_general", "puntaje_gancho", "puntaje_claridad", "puntaje_cta"],
             "properties": {"ad_name": {"type": "string"}, "avatar_id": {"type": "string"}, "voto": {"type": "boolean"}, "motivo": {"type": "string"},
                            "puntaje_general": {"type": "integer", "minimum": 0, "maximum": 10}, "puntaje_gancho": {"type": "integer", "minimum": 0, "maximum": 10},
                            "puntaje_claridad": {"type": "integer", "minimum": 0, "maximum": 10}, "puntaje_cta": {"type": ["integer", "null"], "minimum": 0, "maximum": 10}},
             "additionalProperties": false},
    "pieza": {"type": "object", "required": ["ad_name", "n_votos", "a_favor", "share_si", "banda_confianza", "puntaje_medio", "score", "rango_puestos", "confianza", "posicion"],
              "properties": {"ad_name": {"type": "string"}, "n_votos": {"type": "integer", "minimum": 1}, "a_favor": {"type": "integer", "minimum": 0},
                             "share_si": {"type": "number", "minimum": 0, "maximum": 1},
                             "banda_confianza": {"type": "object", "required": ["metodo", "nivel", "bajo", "alto", "supuesto"],
                                                 "properties": {"metodo": {"const": "wilson95"}, "nivel": {"const": 0.95}, "bajo": {"type": "number", "minimum": 0, "maximum": 1},
                                                                "alto": {"type": "number", "minimum": 0, "maximum": 1}, "supuesto": {"type": "string"}}},
                             "puntaje_medio": {"type": "number"}, "puntaje_mediana": {"type": ["number", "null"]}, "desvio_puntaje": {"type": "number"},
                             "acuerdo": {"type": "number"}, "puntaje_gancho_medio": {"type": "number"}, "puntaje_claridad_medio": {"type": "number"},
                             "puntaje_cta_medio": {"type": ["number", "null"]}, "score": {"type": "number"},
                             "rango_puestos": {"type": "object", "required": ["p05", "p50", "p95"], "properties": {"p05": {"type": "number"}, "p50": {"type": "number"},
                                               "p95": {"type": "number"}, "metodo": {"type": "string"}}},
                             "confianza": {"enum": ["alta", "media", "baja"]}, "posicion": {"type": "integer", "minimum": 1}}},
    "precision": {"type": "object", "required": ["auc", "brier", "etiquetas", "estado"],
                  "properties": {"auc": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "brier": {"type": ["number", "null"], "minimum": 0},
                                 "etiquetas": {"type": "integer", "minimum": 0}, "estado": {"enum": ["acumulando", "sombra", "apagar", "elegible_asesor"]},
                                 "nivel": {"type": "string"}, "ic95": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                                 "p_vs_azar": {"type": ["number", "null"]}, "n_min_etiquetas": {"type": "integer"},
                                 "baselines": {"type": "array", "items": {"type": "object", "required": ["nombre", "auc"], "properties": {"nombre": {"type": "string"},
                                               "auc": {"type": "number"}}}},
                                 "razones": {"type": "array", "items": {"type": "string"}}, "fixture": {"type": "boolean"}}}
  }
}
