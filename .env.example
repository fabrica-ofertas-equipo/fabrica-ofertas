# =============================================================================
# .env.example: TODAS las variables de entorno previstas, SIN valores.
# GENERADO por `python -m infra.variables generar` desde
# infra/plantillas/variables-entorno.yaml (docs/06 D-13). NO EDITAR A MANO:
# cambiar el manifiesto y volver a generar (`infra.variables generar --check`
# falla si quedan desincronizados).
# Copiar a .env (ignorado por git) o cargar en Railway/Cloudflare. Nunca poner
# credenciales en archivos versionados, argumentos de CLI, logs ni pruebas.
# Los bindings de Cloudflare (nombre con un espacio, p. ej. «(binding R2)») se
# configuran en wrangler.toml: se documentan pero no generan línea NOMBRE=.
# =============================================================================

# secreto: referencia al servicio Postgres (red privada)
# usada por: plataformas.railway.servicios.api, plataformas.railway.servicios.etl, plataformas.railway.servicios.motor, plataformas.railway.servicios.respaldo
DATABASE_URL=

# config: ruta de datos de empresa/
# usada por: plataformas.railway.servicios.motor
EMPRESA_DIR=

# config: vivo | prueba | simulado
# usada por: plataformas.railway.servicios.motor
MODO=

# config: act_<id> de la única cuenta (debe estar en cuentas_permitidas)
# usada por: plataformas.railway.servicios.etl, plataformas.railway.servicios.motor
META_AD_ACCOUNT_ID=

# secreto: usuario del sistema operador (ads_management)
# usada por: plataformas.railway.servicios.motor
META_TOKEN_OPERADOR=

# secreto: usuario del sistema de lectura (ads_read); en Fase 1 puede reutilizar el del operador
# usada por: plataformas.railway.servicios.etl, plataformas.railway.servicios.motor
META_TOKEN_LECTURA=

# config: app de empresa del portfolio
# usada por: plataformas.railway.servicios.motor
META_APP_ID=

# secreto: app de Meta; solo para debug_token [VERIFICAR alternativa sin secreto de app]
# usada por: plataformas.railway.servicios.motor
META_APP_SECRET=

# secreto: clave restringida de solo lectura
# usada por: plataformas.railway.servicios.etl, plataformas.railway.servicios.motor
STRIPE_RK_LECTURA=

# secreto: clave restringida Refunds:Write; solo el servicio determinista de D10
# usada por: plataformas.railway.servicios.motor
STRIPE_RK_REEMBOLSO=

# secreto: token cf_lectura
# usada por: plataformas.railway.servicios.motor
CLOUDFLARE_API_TOKEN_LECTURA=

# config: panel de Cloudflare
# usada por: plataformas.github.entornos.produccion, plataformas.github.entornos.pruebas, plataformas.railway.servicios.motor
CLOUDFLARE_ACCOUNT_ID=

# secreto: token de solo lectura [VERIFICAR alcance disponible]
# usada por: plataformas.railway.servicios.motor
RAILWAY_API_TOKEN_LECTURA=

# secreto: token fino de solo lectura del repositorio
# usada por: plataformas.railway.servicios.motor
GITHUB_TOKEN_LECTURA=

# secreto: clave del proveedor con permiso de lectura de dominios y métricas
# usada por: plataformas.railway.servicios.motor
CORREO_API_KEY_LECTURA=

# secreto: clave de firma de estado.json; NO en runners de agentes
# usada por: plataformas.railway.servicios.motor
PREFLIGHT_HMAC_KEY=

# secreto: clave compartida con el Worker watchdog
# usada por: plataformas.cloudflare.workers.watchdog, plataformas.railway.servicios.motor
LATIDO_HMAC=

# config: https://watchdog.<dominio_infra>
# usada por: plataformas.railway.servicios.motor
WATCHDOG_URL=

# secreto: clave del proveedor solo con permiso de enviar
# usada por: plataformas.cloudflare.workers.watchdog, plataformas.railway.servicios.motor
ALERTA_CORREO_API_KEY=

# secreto: servicio de notificaciones push [VERIFICAR proveedor]
# usada por: plataformas.cloudflare.workers.watchdog, plataformas.railway.servicios.motor
ALERTA_PUSH_TOKEN=

# config: direcciones del dueño y del respaldo
# usada por: plataformas.railway.servicios.motor
ALERTA_DESTINO=

# config: fuente de tipos de cambio [DUEÑO: decidir]
# usada por: plataformas.railway.servicios.etl
FX_FUENTE=

# secreto: secreto del destino de finanzas en vivo
# usada por: plataformas.railway.servicios.api
STRIPE_WHSEC_FINANZAS_LIVE=

# secreto: secreto del destino de finanzas en prueba
# usada por: plataformas.railway.servicios.api
STRIPE_WHSEC_FINANZAS_TEST=

# secreto: firma de sesiones del panel
# usada por: plataformas.railway.servicios.api
SESION_SECRETO=

# config: nombre del emisor TOTP
# usada por: plataformas.railway.servicios.api
PANEL_2FA_ISSUER=

# secreto: token R2 de escritura acotado al bucket de respaldos
# usada por: plataformas.railway.servicios.respaldo
R2_RESPALDO_ACCESS_KEY_ID=

# secreto: idem
# usada por: plataformas.railway.servicios.respaldo
R2_RESPALDO_SECRET_ACCESS_KEY=

# config: nombre del bucket de respaldos
# usada por: plataformas.railway.servicios.respaldo
R2_RESPALDO_BUCKET=

# secreto: clave de cifrado del volcado; copia donde el dueño guarde sus claves
# usada por: plataformas.railway.servicios.respaldo
RESPALDO_CLAVE_CIFRADO=

# secreto: clave restringida Checkout Sessions:Write
# usada por: plataformas.cloudflare.workers.crear-sesion
STRIPE_RK_CHECKOUT=

# secreto: firma del catálogo oferta->price_id
# usada por: plataformas.cloudflare.workers.crear-sesion
CATALOGO_HMAC=

# config: versión fija [VERIFICAR en sandbox]
# usada por: plataformas.cloudflare.workers.crear-sesion
STRIPE_API_VERSION=

# config: origenes exactos de los sitios de las ofertas (https://<dominio>), separados por comas; modo formulario: Origin debe coincidir (nunca el Host)
# usada por: plataformas.cloudflare.workers.crear-sesion
ORIGENES_PERMITIDOS=

# config: locales UE/UK que exigen la casilla de renuncia al desistimiento, separados por comas; solo si el catalogo firmado no lo declara (decision-arranque-de-pago)
# usada por: plataformas.cloudflare.workers.crear-sesion
LOCALES_RENUNCIA_REQUERIDA=

# secreto: destino de entrega en vivo
# usada por: plataformas.cloudflare.workers.webhook-stripe
STRIPE_WHSEC_LIVE=

# secreto: destino de entrega en prueba
# usada por: plataformas.cloudflare.workers.webhook-stripe
STRIPE_WHSEC_TEST=

# config: 300 por defecto; nunca 0
# usada por: plataformas.cloudflare.workers.webhook-stripe
STRIPE_TOLERANCIA_SEG=

# secreto: lectura de sesiones, PaymentIntents y charges
# usada por: plataformas.cloudflare.workers.fulfill
STRIPE_RK_ENTREGA=

# secreto: proveedor transaccional; solo enviar
# usada por: plataformas.cloudflare.workers.fulfill
CORREO_API_KEY=

# secreto: firma de tokens de descarga
# usada por: plataformas.cloudflare.workers.descarga, plataformas.cloudflare.workers.fulfill
DESCARGA_HMAC=

# config: parámetro enlace.vencimiento_dias
# usada por: plataformas.cloudflare.workers.fulfill
DESCARGA_DIAS_VENCIMIENTO=

# secreto: token del dataset de ESA oferta (un token por dataset)
# usada por: plataformas.cloudflare.workers.capi
META_CAPI_TOKEN__EJEMPLO=

# config: versión fija de Graph API
# usada por: plataformas.cloudflare.workers.capi
META_API_VERSION=

# secreto: usuario 'pausa' (Fase 2) o copia del operador (Fase 1); solo la cuenta publicitaria
# usada por: plataformas.cloudflare.workers.watchdog
META_TOKEN_PAUSA=

# config: copia de limites.yaml: IDs act_<id>
# usada por: plataformas.cloudflare.workers.watchdog
CUENTAS_PERMITIDAS=

# config: parámetro watchdog.latido_max_min
# usada por: plataformas.cloudflare.workers.watchdog
WATCHDOG_LATIDO_MAX_MIN=

# config: unidad menor, de limites.yaml. OBLIGATORIA (docs/07 §9.2.2, D-13): sin ella /estado responde 503 y C-09 es ROJO crítico, nunca se omite
# usada por: plataformas.cloudflare.workers.watchdog
GASTO_DIARIO_MAX_MINOR=

# config: zona IANA de la cuenta de Meta (decisiones.yaml). OBLIGATORIA: el gasto de 'hoy' se compara en esta zona, no en UTC
# usada por: plataformas.cloudflare.workers.watchdog
CUENTA_TZ=

# config: copia de limites.yaml: limite_gasto_cuenta_meta, unidad menor; pausa al 90 % de account.amount_spent
# usada por: plataformas.cloudflare.workers.watchdog
LIMITE_CUENTA_MINOR=

# secreto: cf_deploy acotado a recursos de pruebas
# usada por: plataformas.github.entornos.produccion, plataformas.github.entornos.pruebas
CLOUDFLARE_API_TOKEN=

# secreto: token de despliegue del proyecto
# usada por: plataformas.github.entornos.produccion
RAILWAY_TOKEN=

# secreto: admin del sistema (business_management); se usa a mano y se revoca tras cada alta
# usada por: plataformas.entorno_local_del_dueno
META_TOKEN_ADMIN_SISTEMA=

# secreto: Products y Prices: Write; solo para stripe_catalogo.py local o con aprobación
# usada por: plataformas.entorno_local_del_dueno
STRIPE_RK_CATALOGO=

# secreto: cf_dns: DNS Edit solo en zonas de ofertas
# usada por: plataformas.entorno_local_del_dueno
CLOUDFLARE_API_TOKEN_DNS=

# secreto: r2_subida: Object Read & Write solo en el bucket de productos
# usada por: plataformas.entorno_local_del_dueno
R2_SUBIDA_ACCESS_KEY_ID=

# secreto: idem
# usada por: plataformas.entorno_local_del_dueno
R2_SUBIDA_SECRET_ACCESS_KEY=

# ── D6 · skill d6-sketch-animado (sketch animado: imágenes, video y lip-sync) ──
# Kie.ai (Nano Banana Pro, Kling AI Avatar, Kling 3.0, Suno) → https://kie.ai/api-key
KIE_API_KEY=
# Google AI Studio (Gemini TTS, voces preset por locale) → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs (efectos de sonido; requiere plan con licencia comercial) → https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── Registro compartido de ofertas tomadas entre instalaciones (buscar-ofertas/scripts/territorio.py) ──
# Token de ESTA instalación; lo da el dueño del registro (infra/workers/registro/montar.sh alta <id>)
REGISTRO_TOKEN=
